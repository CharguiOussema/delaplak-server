{
  "name": "delaplak-server",
  "version": "1.0.0",
  "description": "delaplak api server",
  "main": "./dist/main.js",
  "resolutions": {
    "@types/express-serve-static-core": "4.19.9",
    "@types/express": "4.17.21"
  },
  "scripts": {
    "start:prod": "node ./dist/main.js",
    "build": "tsc && node scripts/copy-assets.js",
    "postinstall": "node setup.js",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx src/scripts/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "release:production": "standard-version -t production-",
    "release:production:major": "standard-version --release-as major -t production-",
    "release:production:minor": "standard-version --release-as minor -t production-",
    "release:production:patch": "standard-version --release-as patch -t production-",
    "release:staging": "standard-version -t staging-",
    "release:staging:major": "standard-version --release-as major -t staging-",
    "release:staging:minor": "standard-version --release-as minor -t staging-",
    "release:staging:patch": "standard-version --release-as patch -t staging-",
    "check-ts:watch": "cross-env NODE_OPTIONS=--max_old_space_size=12000 tsc --noEmit --watch"
  },
  "keywords": [],
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.3",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compare-versions": "6.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.4",
    "cron": "^3.1.7",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "handlebars": "^4.7.8",
    "http-status-codes": "^2.3.0",
    "i18n": "^0.15.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.4.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "redis": "^4.6.15",
    "reflect-metadata": "^0.1.13",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@jest-mock/express": "^2.0.1",
    "@tsconfig/node18": "^18.2.4",
    "@tsconfig/recommended": "^1.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^18.0.4",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "chalk": "4.1.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.24.0",
    "jest": "^29.5.0",
    "mongodb-memory-server": "^9.4.1",
    "prettier": "2.7.1",
    "standard-version": "^9.5.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.5",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=16.17.1",
    "npm": "please use yarn",
    "yarn": ">=1.22.19",
    "pnpm": "please-use-yarn"
  },
  "engineStrict": true
}
