<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Order confirmed</title>
  </head>
  <body style="font-family: Arial, Helvetica, sans-serif; background: #f4f4f4; padding: 24px; margin: 0;">
    <div style="max-width: 560px; margin: 0 auto; background: #ffffff; border-radius: 8px; padding: 32px;">
      <h1 style="color: #1a7a1a; font-size: 22px;">Order confirmed</h1>
      <p style="color: #333; font-size: 15px; line-height: 1.5;">
        Good news — your order <strong>#{{orderId}}</strong> has been confirmed.
      </p>
      <p style="color: #333; font-size: 15px; line-height: 1.5;">
        Total amount: <strong>{{totalAmount}}</strong><br />
        Invoice number: <strong>{{invoiceNumber}}</strong>
      </p>
      <p style="color: #333; font-size: 15px; line-height: 1.5;">
        Your invoice is available for download from your account.
      </p>
      <p style="color: #999; font-size: 12px; margin-top: 32px;">DeLAPLAK-Next — PVC Panels &amp; Wall Solutions</p>
    </div>
  </body>
</html>
