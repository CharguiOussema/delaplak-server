# =================================
# DeLAPLAK-Next Server Environment Configuration
# =================================

# ---------------------------------
# Server Configuration
# ---------------------------------
NODE_ENV=development
NODE_OPTIONS=--max_old_space_size=12000
SERVER_PORT=3001
API_BASE_URL=http://localhost:3001/api
CRM_PATH=http://localhost:3001/api

# ---------------------------------
# Database Configuration
# ---------------------------------
# Option 1: Use Atlas URL (MongoDB Atlas)
ATLAS_URL=

# Option 2: Use local MongoDB or custom host
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=delaplak-dev
# MONGO_DB_USER=
# MONGO_DB_PASSWORD=

# ---------------------------------
# Authentication & Security
# ---------------------------------
SALTKEY=10
SECRETKEY=your-secret-key-here
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# ---------------------------------
# Environment Configuration
# ---------------------------------
ENVIRONMENT=development

# ---------------------------------
# File / upload storage
# ---------------------------------
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3001/uploads

# ---------------------------------
# SMTP / email (leave blank in dev to fall back to an Ethereal test account)
# ---------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DeLAPLAK <no-reply@delaplak.dev>
