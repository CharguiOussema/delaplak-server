{
  "extends": ["@tsconfig/recommended/tsconfig.json"],
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
